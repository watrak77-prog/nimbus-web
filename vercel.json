{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/download", "destination": "/api/download?type=setup" },
    { "source": "/download/portable", "destination": "/api/download?type=portable" },
    { "source": "/download/linux", "destination": "/api/download?type=linux" },
    { "source": "/download/linux-tar", "destination": "/api/download?type=linux-tar" }
  ],
  "headers": [
    {
      "source": "/art/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
